# WestFax API credentials
WESTFAX_USERNAME=your_username
WESTFAX_PASSWORD=your_password
WESTFAX_API_KEY=
WESTFAX_PRODUCT_ID=your_product_id

# Leave unset to use the client default (https://apisecure.westfax.com).
# Current docs host: https://api2.westfax.com
# Sandbox, no live faxes: https://integrate.westfax.com
WESTFAX_API_URL=

# Required by examples/send-fax.js. Use your own fax number.
# The sandbox accepts 5552001111 for a Sent result.
FAX_NUMBER=

# Optional second and third recipients for the multi-recipient example.
FAX_NUMBER2=
FAX_NUMBER3=

CSID=0000000000
ANI=0000000000
FEEDBACK_EMAIL=your@email.com
