# WestFax API credentials. Use username and password, or an API key.
WESTFAX_USERNAME=your_username
WESTFAX_PASSWORD=your_password
WESTFAX_API_KEY=
WESTFAX_PRODUCT_ID=your_product_id

# Production hosts. The client defaults to the legacy host, which is still live.
# Current WestFax docs publish https://api2.westfax.com.
# Sandbox (no live faxes): https://integrate.westfax.com
WESTFAX_API_URL=https://apisecure.westfax.com

# Used only by `npm run test:real`. That command reads the product list.
# It does not send a fax.
